# 知微 Zhiwei — 环境变量模板
#
# 用法：把这个文件复制成同目录下的 .env，填上你自己的值。
#     cp .env.example .env
# .env 已经在 .gitignore 里，不会被提交；真填了值的 .env 别截图、别贴进任何聊天。
#
# 填了 KNOWE_MODEL_API_KEY 之后，模型密钥只从这份文件读，
# 设置界面里粘的 key 只活到下次重启，磁盘上的 settings.json 一份明文都不留。
# 想反过来让界面里填的 key 持久保存：把这行删掉即可（不设 = 走原来的落盘逻辑）。

# ── 模型服务（必填）─────────────────────────────────────
# OpenAI 兼容协议都能接：DeepSeek / 火山方舟 / 智谱 / Moonshot / 本地 vLLM 都一样。
# 这一把 key 会供给本机上配置的全部模型绑定。
KNOWE_MODEL_API_KEY=

# 想只给某一家厂商供密钥（多厂商混用时），把下面两行的注释去掉并填上，作用域就收窄了：
# 只有 provider 与 base_url 同时匹配的绑定才会拿到这把 key。
# ⚠ 别照抄示例值：这两个值必须和「设置」里那条绑定一模一样（base_url 只差一个 /v1 就算不匹配），
#   一个都不匹配时 env 里的 key 不会注入——那是故意留的，为了不误伤你已有的配置。
# KNOWE_MODEL_PROVIDER=deepseek
# KNOWE_MODEL_BASE_URL=https://api.deepseek.com

# ── 老部署兼容位（可选，等价于 KNOWE_MODEL_API_KEY）──────
# 历史上 key 走这三个变量，仍在生效；新装建议只用上面那组。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=

# ── 数据目录（可选）─────────────────────────────────────
# 不设时用 ./data（开发态），桌面版由 Electron 主进程注入绝对路径。
# KNOWE_DATA_DIR=

# ── 运行档位（可选）─────────────────────────────────────
# fake = 不调任何模型、零 token 消耗，用来看界面和跑测试；
# real = 真调模型。演示前确认这里是 real（或留空走默认）。
# KNOWE_AGENT=fake

# ── .env 文件本身放别处时（可选）────────────────────────
# 优先级：KNOWE_ENV_FILE > 安装根目录/.env > 数据目录/.env > 仓库根/.env
# KNOWE_ENV_FILE=
